{
  "mcpServers": {
    "mcx-core": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--quiet",
        "--project", "${CLAUDE_PLUGIN_ROOT}/mcp",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/motorcortex_core_mcp.py"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
